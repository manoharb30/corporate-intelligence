FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# System deps for weasyprint (pango/cairo), lxml (libxml2), and a few utilities
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpango-1.0-0 libpangoft2-1.0-0 \
    libcairo2 \
    libxml2 libxslt1.1 \
    libffi-dev \
    curl \
    git \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python deps first (caches well — requirements.txt invalidates less often than code)
COPY backend/requirements.txt /app/requirements.txt
RUN pip install --upgrade pip && pip install -r /app/requirements.txt

# Copy backend source. .dockerignore at repo root excludes venv, .env, logs, caches, frontend.
COPY backend /app/backend

WORKDIR /app/backend

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
